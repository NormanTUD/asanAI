# Copy to /etc/asanai-rag.env (the installer does this for you).
ASANAI_BLOG_DIR=/var/www/asanai/blog
ASANAI_RAG_DATA=/var/lib/asanai-rag/data
ASANAI_RAG_CACHE=/var/lib/asanai-rag/cache.sqlite
ASANAI_RAG_QUERIES_DB=/var/lib/asanai-rag/queries.sqlite
ASANAI_RAG_HOST=127.0.0.1
ASANAI_RAG_PORT=8090

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

HF_HOME=/var/lib/asanai-rag/hf
FASTEMBED_CACHE_PATH=/var/lib/asanai-rag/fastembed

MAX_QUEUE=20
MAX_QUESTION_CHARS=2000
MAX_ANSWER_TOKENS=220
NUM_CTX=4096
REQUEST_TIMEOUT=180
RATE_DAY=20
RATE_SECONDS=5
CACHE_TTL_SECONDS=2592000
INITIAL_ETA_SECONDS=30
STREAM_BUFFER_CHARS=120
QUERY_LOG_RETENTION_DAYS=180
