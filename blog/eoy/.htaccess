# End-of-year split of the Ten Minutes intuition lesson. It is self-contained:
# local assets and demos, its own prepend, no blog-wide auto-prepend.
RewriteEngine On
RewriteOptions Inherit

# Pretty URLs: /eoy/1.php redirects to /eoy/1, and /eoy/1 serves 1.php.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?\s]+)\.php(?:\?|\s) [NC]
RewriteRule ^ %1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ %{REQUEST_URI}.php [L]

<IfModule mod_php8.c>
	php_value auto_prepend_file "prepend.php"
</IfModule>
<IfModule mod_php.c>
	php_value auto_prepend_file "prepend.php"
</IfModule>
<IfModule mod_php7.c>
	php_value auto_prepend_file "prepend.php"
</IfModule>

<FilesMatch "^(\.user\.ini|prepend\.php|_page\.php)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Deny from all
	</IfModule>
</FilesMatch>

# Prevent stale lesson HTML/JS/CSS in the WordPress proxy and browsers.
<IfModule mod_headers.c>
	<FilesMatch "\.(php|js|css)$">
		Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
		Header set Pragma "no-cache"
		Header set Expires "0"
		Header set CDN-Cache-Control "no-store"
		Header set Surrogate-Control "no-store"
		Header set X-Accel-Expires "0"
	</FilesMatch>
</IfModule>
