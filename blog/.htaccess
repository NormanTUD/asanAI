RewriteEngine On

# Search index cache must not be served directly.
<FilesMatch "^\.search_cache\.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>


# 1. Externer Redirect: .php entfernen (dynamisch und ohne Pfad-Verdopplung)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Internes Umschreiben: Im Hintergrund die .php Datei laden
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ %{REQUEST_URI}.php [L]

# 3. Mobile / Responsive Polish — auto-prepend the loader into every
#    PHP response so mobile.css + mobile.js load on every page,
#    including standalone module pages that go through functions.php's
#    auto-render path (which we don't touch).
#    The prepended file (mobile-prepend.php) starts output buffering
#    with a callback that injects <link>/<script> tags into </head>.
#    It's defensive: it no-ops on non-HTML responses and skips
#    injection if mobile.css is already present in the buffer (so
#    explicit includes in index.php / index_full.php won't double-load).
<IfModule mod_php8.c>
    php_value auto_prepend_file "mobile-prepend.php"
</IfModule>
<IfModule mod_php.c>
    php_value auto_prepend_file "mobile-prepend.php"
</IfModule>
<IfModule mod_php7.c>
    php_value auto_prepend_file "mobile-prepend.php"
</IfModule>

# PHP/HTML pages must never be served from an unvalidated cache. They
# carry ?v=filemtime cache-busters on every CSS/JS asset, so a
# revalidated (304) page is cheap while guaranteeing fresh markup —
# without this a phone browser keeps a stale page (heuristic caching,
# no ETag/Last-Modified on rewritten .php URLs) and the busters never
# get a chance to take effect.
#
# Static assets (.css/.js/.jpg/.png/.svg/.woff2) are versioned via
# ?v=<filemtime>, so the URL changes whenever the file changes —
# they are safe to cache aggressively, which keeps page loads fast.
<IfModule mod_headers.c>
    # Everything (in particular the rewritten PHP pages) revalidates.
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always set Pragma "no-cache"
    # …except static assets, which are ?v-versioned and therefore safe
    # to cache forever. (Later Header directives win, so this comes
    # after the blanket rule above.)
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|ico|woff2?|ttf|webp)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
