RewriteEngine On

# The December calendar is a standalone landing page (december.html).
# Serve it for the pretty URL before the generic .php rewrite.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^december$ december.html [L]

# Search index cache must not be served directly.
<FilesMatch "^\.search_cache\.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Local analytics kill switch must not be served.
<FilesMatch "^\.analytics_disabled$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Local reader-feedback kill switch must not be served.
<FilesMatch "^\.feedback_disabled$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Anonymous analytics database: never served by the web.
RewriteRule ^analytics_data/ - [F,L]


# 1. External redirect: remove .php (dynamic, without duplicated paths)
#    stats.php and track.php are POST targets; never redirect their .php form.
RewriteCond %{REQUEST_URI} !/stats\.php(?:\?|$)
RewriteCond %{REQUEST_URI} !/track\.php(?:\?|$)
RewriteCond %{REQUEST_URI} !/feedback\.php(?:\?|$)
RewriteCond %{REQUEST_URI} !/feedback_track\.php(?:\?|$)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?\s]+)\.php(?:\?|\s) [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Internal rewrite: load the .php file in the background
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ %{REQUEST_URI}.php [L]

# 3. Mobile / Responsive Polish — auto-prepend the loader into every
#    PHP response so mobile.css + mobile.js load on every page,
#    including standalone module pages that go through functions.php's
#    auto-render path (which we don't touch).
#    The prepended file (mobile-prepend.php) starts output buffering
#    with a callback that injects <link>/<script> tags into </head>.
#    It's defensive: it no-ops on non-HTML responses and skips
#    injection if mobile.css is already present in the buffer (so
#    explicit includes in index.php / index_full.php won't double-load).
<IfModule mod_php8.c>
    php_value auto_prepend_file "mobile-prepend.php"
</IfModule>
<IfModule mod_php.c>
    php_value auto_prepend_file "mobile-prepend.php"
</IfModule>
<IfModule mod_php7.c>
    php_value auto_prepend_file "mobile-prepend.php"
</IfModule>

# Pages (including the rewritten .php URLs) must never be served from
# an unvalidated cache. They carry ?v=filemtime cache-busters on every
# CSS/JS asset, so a revalidated (304) page is cheap while guaranteeing
# fresh markup — without this a phone browser keeps a stale page
# (heuristic caching, no ETag/Last-Modified on rewritten .php URLs) and
# the busters never get a chance to take effect. Static assets are
# versioned via ?v=<filemtime>, so their URLs change when the file
# does; no-cache just makes the browser revalidate them (cheap 304s).
<IfModule mod_headers.c>
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always set Pragma "no-cache"
</IfModule>
