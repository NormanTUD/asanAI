#!/usr/bin/env python3
"""Guard: the Toolkit and the blog share one origin. A broad
localStorage.clear() in the Toolkit wipes the reader's blog progress
(XP, achievements, learning paths, review deck), so only the app's own
keys may be removed.
"""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PATTERN = re.compile(r"(?:window\.)?(?:localStorage|local_store)\.clear\s*\(")
FILES = sorted(ROOT.glob("*.js")) + sorted(ROOT.glob("blog/*.js")) + sorted(ROOT.glob("blog/modules/*.js"))

problems = 0
for path in FILES:
	if path.name.endswith(".min.js"):
		continue
	try:
		lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
	except OSError as exc:
		print(f"cannot read {path}: {exc}")
		problems += 1
		continue
	for number, line in enumerate(lines, 1):
		if PATTERN.search(line):
			print(f"{path.relative_to(ROOT)}:{number}: broad localStorage.clear() wipes blog progress")
			problems += 1

if problems:
	print("\nRemove only the Toolkit's own keys (e.g. the tensorflowjs_models/ prefix).")
	sys.exit(1)
print("No broad localStorage.clear() in the Toolkit or blog sources.")
